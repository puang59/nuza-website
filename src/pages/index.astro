---
import { fetchChangelog, versionFromTag } from '../lib/changelog';
import Base from '../layouts/Base.astro';
import InfoSection from '../components/InfoSection.astro';
import PreviewsSection from '../components/PreviewsSection.astro';
import ChangelogSection from '../components/ChangelogSection.astro';
import Ticker from '../components/Ticker.astro';

const changelogs = await fetchChangelog();
const latestRelease = changelogs[0]?.release;

// Empty when GitHub could not be reached at build time; the download buttons
// then link to the releases page instead of guessing at a file name.
const latestVersion = latestRelease?.tag ? versionFromTag(latestRelease.tag) : '';

const SITE_URL = Astro.site?.toString().replace(/\/$/, '') ?? 'https://nuza.puang.in';
const OG_IMAGE = `${SITE_URL}/banner.png`;
const DEMO_VIDEO = 'https://nuza-cdn.puang.in/nuza-intro-v3.mp4';

// No em dash in either: this is what a search result shows, and it reads
// better as a plain sentence than as two halves.
const TITLE = 'nuza: simple, lightweight Obsidian alternative for notes';
const DESCRIPTION =
  'A simple, lightweight Obsidian alternative. nuza is a free, open-source markdown note taking app for macOS, Windows and Linux, with Vim keybindings.';

const structuredData = [
  // Tells Google what to call the site. Without it, a subdomain is shown
  // under its parent domain's name instead of its own.
  {
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: 'nuza',
    alternateName: ['nuza notes', 'nuza markdown editor'],
    url: `${SITE_URL}/`,
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${SITE_URL}/#app`,
    name: 'nuza',
    alternateName: 'nuza markdown editor',
    description: DESCRIPTION,
    url: `${SITE_URL}/`,
    image: OG_IMAGE,
    screenshot: OG_IMAGE,
    applicationCategory: 'ProductivityApplication',
    applicationSubCategory: 'Note taking app',
    operatingSystem: 'macOS, Windows, Linux',
    ...(latestVersion ? { softwareVersion: latestVersion } : {}),
    license: 'https://github.com/puang59/nuza/blob/main/LICENSE',
    isAccessibleForFree: true,
    featureList: [
      'Markdown notes stored as plain files in a folder on your computer',
      'Vim keybindings',
      'Wiki-links and backlinks between notes',
      'Full-text search across your notes',
      'Quick open and tabs',
      'Live rendering of tables, tasks, images and code blocks',
      'Light and dark themes',
      'Open source under the MIT license',
    ],
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    author: {
      '@type': 'Organization',
      name: 'nuza',
      url: 'https://github.com/puang59/nuza',
    },
    downloadUrl: 'https://github.com/puang59/nuza/releases/latest',
    sameAs: ['https://github.com/puang59/nuza'],
  },
  {
    '@type': 'VideoObject',
    '@id': `${SITE_URL}/#demo-video`,
    name: 'nuza intro: a lightweight markdown note taking app',
    description:
      'A short tour of nuza: a note rendering as it is written, the file tree beside it, open tabs across the top and Vim mode in the status bar.',
    thumbnailUrl: `${SITE_URL}/demo-poster.webp`,
    contentUrl: DEMO_VIDEO,
    uploadDate: '2026-10-01T09:50:49Z',
    duration: 'PT44S',
  },
];
---

<Base
  title={TITLE}
  description={DESCRIPTION}
  structuredData={structuredData}
  preloadImage="/bg.webp"
  version={latestVersion}
>
  <InfoSection version={latestVersion} />
  <Ticker />
  <PreviewsSection />
  <Ticker text="plain markdown · vim keybindings · local files" />
  <ChangelogSection changelogs={changelogs} />
  <Ticker />

  <script src="../scripts/demo-video.ts"></script>
  <script src="../scripts/previews.ts"></script>
</Base>
