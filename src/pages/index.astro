---
import '../styles/global.css';
import { fetchChangelog } from '../lib/changelog';
import LeftPanel from '../components/LeftPanel.astro';
import AboutSection from '../components/AboutSection.astro';
import ChangelogSection from '../components/ChangelogSection.astro';

const { release, commits } = await fetchChangelog();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>nuza</title>
    <meta name="description" content="nuza is a lightweight, open-source alternative to Obsidian. A fast, Vim-powered markdown editor built natively for your desktop with Tauri." />
    <meta name="keywords" content="nuza, obsidian alternative, markdown editor, note-taking, tauri, open source, vim, lightweight" />
    <meta property="og:title" content="nuza — a better note-taking app" />
    <meta property="og:description" content="Lightweight. Open source. A better way to take notes." />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#090909" />
  </head>

  <body class="bg-[#090909] text-neutral-200 font-mono min-h-screen">

    <main class="flex flex-col lg:flex-row min-h-screen lg:h-screen w-full lg:overflow-hidden">
      <LeftPanel />

      <!-- ═══════════════════════════════════════
           RIGHT — snap-y: About → Changelog
      ═══════════════════════════════════════ -->
      <div id="right-col" class="flex-1 order-2 overflow-y-auto lg:h-screen no-scrollbar">
        <AboutSection />
        <ChangelogSection release={release} commits={commits} />
      </div>
    </main>

    <script src="../scripts/downloads.ts"></script>
    <script src="../scripts/scroll.ts"></script>
    <script src="../scripts/ascii-background.ts"></script>
  </body>
</html>
