---
import '../styles/global.css';
import { fetchChangelog } from '../lib/changelog';
import LeftPanel from '../components/LeftPanel.astro';
import AboutSection from '../components/AboutSection.astro';
import PreviewsSection from '../components/PreviewsSection.astro';
import ChangelogSection from '../components/ChangelogSection.astro';

const changelogs = await fetchChangelog();
const latestRelease = changelogs[0]?.release;

const latestVersion = latestRelease?.tag ? latestRelease.tag.replace(/^(app-)?v/, '') : '0.1.0';

const SITE_URL = Astro.site?.toString().replace(/\/$/, '') ?? 'https://nuza.puang.in';
const OG_IMAGE = `${SITE_URL}/banner.png`;
const PAGE_URL = `${SITE_URL}${Astro.url.pathname}`;

// No em dash in either: this is what a search result shows, and it reads
// better as a plain sentence than as two halves.
const TITLE = 'nuza: simple, lightweight Obsidian alternative for notes';
const DESCRIPTION =
  'A simple, lightweight Obsidian alternative. nuza is a free, open-source markdown note taking app for macOS, Windows and Linux, with Vim keybindings.';
const IMAGE_ALT = 'nuza, a lightweight open-source markdown note taking app with Vim keybindings';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    // Tells Google what to call the site. Without it, a subdomain is shown
    // under its parent domain's name instead of its own.
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: 'nuza',
      alternateName: ['nuza notes', 'nuza markdown editor'],
      url: `${SITE_URL}/`,
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${SITE_URL}/#app`,
      name: 'nuza',
      alternateName: 'nuza markdown editor',
      description: DESCRIPTION,
      url: `${SITE_URL}/`,
      image: OG_IMAGE,
      screenshot: OG_IMAGE,
      applicationCategory: 'ProductivityApplication',
      applicationSubCategory: 'Note taking app',
      operatingSystem: 'macOS, Windows, Linux',
      softwareVersion: latestVersion,
      license: 'https://github.com/puang59/nuza/blob/main/LICENSE',
      isAccessibleForFree: true,
      featureList: [
        'Markdown notes stored as plain files in a folder on your computer',
        'Vim keybindings',
        'Wiki-links and backlinks between notes',
        'Full-text search across your notes',
        'Light and dark themes',
        'Open source under the MIT license',
      ],
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      author: {
        '@type': 'Organization',
        name: 'nuza',
        url: 'https://github.com/puang59/nuza',
      },
      downloadUrl: 'https://github.com/puang59/nuza/releases/latest',
      sameAs: ['https://github.com/puang59/nuza'],
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary -->
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="keywords" content="nuza, obsidian alternative, lightweight obsidian alternative, simple note taking app, markdown note taking, markdown editor, open source note taking, vim notes app, local-first notes, privacy-first notes, notes app for developers, markdown app macOS, markdown app windows, markdown app linux" />
    <meta name="author" content="nuza" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <link rel="canonical" href={PAGE_URL} />

    <!-- Icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph (Facebook, LinkedIn, Discord, WhatsApp, Slack, Telegram, iMessage, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={PAGE_URL} />
    <meta property="og:site_name" content="nuza" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:secure_url" content={OG_IMAGE} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content={IMAGE_ALT} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={PAGE_URL} />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:image:alt" content={IMAGE_ALT} />

    <!-- Theming -->
    <meta name="theme-color" content="#090909" />
    <meta name="color-scheme" content="dark" />

    <!-- Perf: font preconnects (see global.css) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>

  <body class="bg-[#090909] text-neutral-200 font-mono min-h-screen" data-latest-version={latestVersion}>

    <main class="flex flex-col lg:flex-row min-h-screen lg:h-screen w-full lg:overflow-hidden">
      <LeftPanel version={latestVersion} />
      <div id="right-col" class="flex-1 order-2 overflow-y-auto lg:h-screen no-scrollbar">
        <AboutSection version={latestVersion} />
        <PreviewsSection />
        <ChangelogSection changelogs={changelogs} />
      </div>
    </main>

    <script src="../scripts/downloads.ts"></script>
    <script src="../scripts/scroll.ts"></script>
    <script src="../scripts/ascii-background.ts"></script>
    <script src="../scripts/demo-video.ts"></script>
    <script src="../scripts/previews.ts"></script>
  </body>
</html>
