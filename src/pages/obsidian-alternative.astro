---
import { fetchLatestVersion } from '../lib/changelog';
import Base from '../layouts/Base.astro';
import FaqSection from '../components/FaqSection.astro';
import Ticker from '../components/Ticker.astro';

const latestVersion = await fetchLatestVersion();

const SITE_URL = Astro.site?.toString().replace(/\/$/, '') ?? 'https://nuza.puang.in';
const PAGE_URL = `${SITE_URL}/obsidian-alternative/`;

const TITLE = 'nuza: a simple, lightweight Obsidian alternative';
const DESCRIPTION =
  'nuza is a free, open-source markdown note taking app for macOS, Windows and Linux. See how it compares with Obsidian and who it is for.';

const features = [
  'Markdown that renders as you type, with tables, tasks, images and frontmatter properties',
  'Wiki-links between notes, and backlinks to see what links to the note you have open',
  'Tabs, quick open, and search across the text of every note',
  'Vim keybindings, off until you switch them on',
  'Light and dark themes, and an accent colour you choose',
  'Autosave, and your last session reopened when you come back',
];

// What each app does, said only where it is plain fact about both. The point
// of the table is to help someone choose, so the rows nuza loses come first.
const comparison = [
  ['Plugins', 'None. What is built in is what you get.', 'A large community plugin ecosystem.'],
  ['Graph view', 'No.', 'Yes.'],
  ['Mobile apps', 'No. Desktop only.', 'iOS and Android.'],
  ['Sync', 'None of its own. Use any folder sync you already trust.', 'Paid sync service available.'],
  ['Source code', 'Open source, MIT license.', 'Closed source.'],
  ['Built with', 'Tauri and Rust, using the webview your system already has.', 'Electron.'],
  ['Your notes are', 'Markdown files in a folder you choose.', 'Markdown files in a vault folder.'],
  ['Wiki-links and backlinks', 'Yes.', 'Yes.'],
  ['Platforms', 'macOS, Windows, Linux.', 'macOS, Windows, Linux, iOS, Android.'],
];

const faqs = [
  {
    question: 'Is nuza a good Obsidian alternative?',
    answer:
      'It is if what you want from Obsidian is the writing: markdown notes in a folder, wiki-links, backlinks, search and tabs, in a smaller and quicker app. It is not if you rely on plugins, the graph view, or mobile apps, because nuza does not have them.',
  },
  {
    question: 'Is nuza free?',
    answer:
      'Yes. nuza is free and open source under the MIT license, with no account and no subscription. The source is on GitHub.',
  },
  {
    question: 'Can I open my Obsidian vault in nuza?',
    answer:
      'nuza opens any folder of markdown files, so you can point it at an existing vault. Wiki-links and frontmatter properties work. Anything that depends on an Obsidian plugin is not rendered.',
  },
  {
    question: 'Does nuza have Vim keybindings?',
    answer:
      'Yes. Vim mode is built in. It is off until you turn it on in settings, so nobody gets it by surprise.',
  },
  {
    question: 'Is nuza lightweight?',
    answer:
      'nuza is a Tauri app: a Rust backend with the webview your operating system already provides, instead of a bundled copy of a browser. It has no plugin system to load, which is part of why it stays small and starts quickly.',
  },
  {
    question: 'Where are my notes stored, and does nuza sync them?',
    answer:
      'Your notes are plain markdown files in a folder on your computer. nuza does not upload them or sync them itself. If you want them on more than one machine, put the folder in iCloud Drive, Dropbox, Syncthing or whatever you already use.',
  },
  {
    question: 'Which platforms does nuza run on?',
    answer:
      'macOS, Windows and Linux. Downloads are on the GitHub releases page.',
  },
];

const structuredData = [
  {
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: 'nuza',
    alternateName: ['nuza notes', 'nuza markdown editor'],
    url: `${SITE_URL}/`,
  },
  {
    '@type': 'WebPage',
    '@id': `${PAGE_URL}#page`,
    url: PAGE_URL,
    name: TITLE,
    description: DESCRIPTION,
    isPartOf: { '@id': `${SITE_URL}/#website` },
    about: { '@id': `${SITE_URL}/#app` },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'nuza', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Obsidian alternative', item: PAGE_URL },
    ],
  },
];
---

<Base title={TITLE} description={DESCRIPTION} structuredData={structuredData} version={latestVersion}>
  <article>

    <header class="band">
      <div class="col px-5 py-12 sm:px-10 sm:py-16">
        <div class="rise-in">
          <nav aria-label="Breadcrumb" class="label">
            <a href="/" class="transition-colors hover:text-white">nuza</a>
            <span class="mx-1.5 text-zinc-600" aria-hidden="true">//</span>
            <span class="text-zinc-300" aria-current="page">Obsidian alternative</span>
          </nav>
        </div>

        <h1 class="rise-in heading mt-6 max-w-3xl text-balance text-[1.65rem] leading-[1.2] sm:text-4xl sm:leading-[1.15]" style="--delay: 80ms">
          A simple, lightweight Obsidian alternative
        </h1>

        <div class="rise-in mt-6 max-w-2xl space-y-3 text-pretty text-[13px] leading-[1.8] text-zinc-300 sm:text-[14.5px]" style="--delay: 160ms">
          <p>
            <strong class="font-medium text-white">nuza</strong> is a free, open-source markdown note
            taking app for macOS, Windows and Linux. Your notes are plain files in a folder on your
            computer, it opens quickly, and it has Vim keybindings built in.
          </p>
          <p class="text-zinc-400">
            It does less than Obsidian on purpose. This page is about what that means, so you can
            tell whether it suits you.
          </p>
        </div>

        <div class="rise-in mt-8 flex flex-wrap gap-3" style="--delay: 240ms">
          <a href="https://github.com/puang59/nuza/releases/latest" data-dl-quick class="btn btn-primary">
            Download nuza
          </a>
          <a href="/" class="btn btn-ghost">See it in action</a>
        </div>
      </div>
    </header>

    <section class="band" aria-labelledby="what">
      <div class="col">
        <div class="border-b border-line px-5 py-5 sm:px-10">
          <h2 id="what" class="label">What you get</h2>
        </div>
        <ul class="grid sm:grid-cols-2">
          {features.map((feature) => (
            <li class="flex items-start gap-3 border-b border-line px-5 py-5 text-[13px] leading-[1.8] text-zinc-300 sm:px-10 sm:odd:border-r sm:[&:nth-last-child(-n+2)]:border-b-0">
              <span class="mt-[0.55rem] h-1.5 w-1.5 shrink-0 bg-accent" aria-hidden="true"></span>
              {feature}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="band" aria-labelledby="compare">
      <div class="col">
        <div class="border-b border-line px-5 py-5 sm:px-10">
          <h2 id="compare" class="label">nuza and Obsidian, side by side</h2>
        </div>
        <div class="px-4 py-6 sm:px-10 sm:py-10" data-reveal>
          <div class="box thin-scrollbar overflow-x-auto">
            <table class="w-full min-w-[36rem] border-collapse text-left text-[13px] leading-[1.7]">
              <caption class="sr-only">How nuza and Obsidian differ</caption>
              <thead>
                <tr class="border-b border-line text-[11px] uppercase tracking-[0.16em] text-zinc-400">
                  <th scope="col" class="px-4 py-3.5 font-normal sm:px-6"><span class="sr-only">Feature</span></th>
                  <th scope="col" class="border-l border-line px-4 py-3.5 font-bold text-accent sm:px-6">nuza</th>
                  <th scope="col" class="border-l border-line px-4 py-3.5 font-bold text-zinc-200 sm:px-6">Obsidian</th>
                </tr>
              </thead>
              <tbody>
                {comparison.map(([feature, nuza, obsidian]) => (
                  <tr class="border-b border-line align-top transition-colors last:border-0 hover:bg-raised">
                    <th scope="row" class="px-4 py-3.5 font-medium text-zinc-100 sm:px-6">{feature}</th>
                    <td class="border-l border-line px-4 py-3.5 text-zinc-300 sm:px-6">{nuza}</td>
                    <td class="border-l border-line px-4 py-3.5 text-zinc-400 sm:px-6">{obsidian}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="who">
      <div class="col">
        <div class="border-b border-line px-5 py-5 sm:px-10">
          <h2 id="who" class="label">Who it is for</h2>
        </div>
        <div class="grid md:grid-cols-2">
          <div class="border-b border-line px-5 py-8 sm:px-10 md:border-b-0 md:border-r md:py-10">
            <div data-reveal>
              <h3 class="text-[13px] font-bold uppercase tracking-[0.08em] text-white">Choose nuza</h3>
              <p class="mt-4 text-[13px] leading-[1.85] text-zinc-400">
                nuza suits you if you want to open a folder of markdown and write, and you would
                rather have an app that is small, quick and does a few things well than one you
                configure. It is a good fit for developers, and for anyone who wants Vim keys in
                their notes.
              </p>
            </div>
          </div>
          <div class="px-5 py-8 sm:px-10 md:py-10">
            <div data-reveal style="--delay: 90ms">
              <h3 class="text-[13px] font-bold uppercase tracking-[0.08em] text-white">Stay with Obsidian</h3>
              <p class="mt-4 text-[13px] leading-[1.85] text-zinc-400">
                Stay with Obsidian if your notes depend on plugins, if you want a graph view, or if
                you need your notes on a phone. Those are real strengths and nuza does not try to
                match them.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="faq">
      <div class="col">
        <div class="border-b border-line px-5 py-5 sm:px-10">
          <h2 id="faq" class="label">Questions</h2>
        </div>
        <div class="mx-auto max-w-3xl px-4 py-6 sm:px-10 sm:py-10">
          <FaqSection faqs={faqs} openFirst />
        </div>
      </div>
    </section>
  </article>

  <Ticker />

  <p slot="footer-note" class="mt-6 border-t border-white/10 pt-4 text-center text-[10px] leading-relaxed text-zinc-400 md:text-left">
    Obsidian is a trademark of its owners. nuza is an independent project and is not affiliated
    with or endorsed by Obsidian.
  </p>
</Base>
