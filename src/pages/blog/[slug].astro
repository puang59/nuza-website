---
import { render } from 'astro:content';
import { fetchLatestVersion } from '../../lib/changelog';
import { fetchPosts, formatDate, postPath, readingMinutes, type Post } from '../../lib/blog';
import Base from '../../layouts/Base.astro';
import Ticker from '../../components/Ticker.astro';

export async function getStaticPaths() {
  const posts = await fetchPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    // The other posts go along, newest first, for the list under this one.
    props: { post, others: posts.filter((other) => other.id !== post.id).slice(0, 3) },
  }));
}

export interface Props {
  post: Post;
  others: Post[];
}

const { post, others } = Astro.props;
const { title, description, pubDate, author, mentionsObsidian } = post.data;

const [latestVersion, { Content }] = await Promise.all([fetchLatestVersion(), render(post)]);

const SITE_URL = Astro.site?.toString().replace(/\/$/, '') ?? 'https://nuza.puang.in';
const BLOG_URL = `${SITE_URL}/blog/`;
const PAGE_URL = `${SITE_URL}${postPath(post)}`;
const published = pubDate.toISOString();

const structuredData = [
  {
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: 'nuza',
    alternateName: ['nuza notes', 'nuza markdown editor'],
    url: `${SITE_URL}/`,
  },
  {
    '@type': 'BlogPosting',
    '@id': `${PAGE_URL}#post`,
    mainEntityOfPage: PAGE_URL,
    url: PAGE_URL,
    headline: title,
    description,
    image: `${SITE_URL}/banner.png`,
    datePublished: published,
    dateModified: published,
    author: { '@type': 'Person', name: author, url: 'https://github.com/puang59' },
    publisher: {
      '@type': 'Organization',
      name: 'nuza',
      url: `${SITE_URL}/`,
      logo: { '@type': 'ImageObject', url: `${SITE_URL}/icon-512.png` },
    },
    isPartOf: { '@id': `${BLOG_URL}#blog` },
    about: { '@id': `${SITE_URL}/#app` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'nuza', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: BLOG_URL },
      { '@type': 'ListItem', position: 3, name: title, item: PAGE_URL },
    ],
  },
];
---

<Base
  title={`${title} | nuza`}
  description={description}
  structuredData={structuredData}
  article={{ author, publishedTime: published }}
  version={latestVersion}
>
  <article>
    <header class="band">
      <div class="col px-5 py-12 sm:px-10 sm:py-16">
        <div class="rise-in">
          <nav aria-label="Breadcrumb" class="label">
            <a href="/" class="transition-colors hover:text-white">nuza</a>
            <span class="mx-1.5 text-zinc-600" aria-hidden="true">//</span>
            <a href="/blog/" class="transition-colors hover:text-white">Blog</a>
          </nav>
        </div>

        <h1 class="rise-in heading mt-6 max-w-3xl text-balance text-[1.5rem] leading-[1.25] sm:text-[2rem] sm:leading-[1.2]" style="--delay: 80ms">
          {title}
        </h1>

        <p class="rise-in label mt-6" style="--delay: 160ms">
          <time datetime={published}>{formatDate(pubDate)}</time>
          <span class="mx-1.5 text-zinc-600" aria-hidden="true">//</span>
          By {author}
          <span class="mx-1.5 text-zinc-600" aria-hidden="true">//</span>
          {readingMinutes(post)} min read
        </p>
      </div>
    </header>

    <div class="band">
      <div class="col px-5 py-10 sm:px-10 sm:py-14">
        <div class="post mx-auto max-w-[44rem]">
          <Content />
        </div>

        <div class="mx-auto mt-12 flex max-w-[44rem] flex-wrap gap-3 border-t border-line pt-8">
          <a href="https://github.com/puang59/nuza/releases/latest" data-dl-quick class="btn btn-primary">
            Download nuza
          </a>
          <a href="/blog/" class="btn btn-ghost">All posts</a>
        </div>
      </div>
    </div>
  </article>

  {others.length > 0 && (
    <section class="band" aria-labelledby="more">
      <div class="col">
        <div class="border-b border-line px-5 py-5 sm:px-10">
          <h2 id="more" class="label">Keep reading</h2>
        </div>
        <ul class="grid md:grid-cols-3">
          {others.map((other) => (
            <li class="border-b border-line last:border-b-0 md:border-b-0 md:border-r md:last:border-r-0">
              <a href={postPath(other)} class="group block h-full px-5 py-8 transition-colors hover:bg-raised sm:px-10 md:px-8">
                <p class="label">
                  <time datetime={other.data.pubDate.toISOString()}>{formatDate(other.data.pubDate)}</time>
                </p>
                <h3 class="mt-3 text-balance text-[13px] font-bold leading-[1.6] text-white group-hover:text-accent sm:text-[14px]">
                  {other.data.title}
                </h3>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <Ticker />

  {mentionsObsidian && (
    <p slot="footer-note" class="mt-6 border-t border-white/10 pt-4 text-center text-[10px] leading-relaxed text-zinc-400 md:text-left">
      Obsidian is a trademark of its owners. nuza is an independent project and is not affiliated
      with or endorsed by Obsidian.
    </p>
  )}
</Base>
