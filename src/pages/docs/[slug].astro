---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { fetchLatestVersion } from '../../lib/changelog';
import { formatDate } from '../../lib/blog';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

export interface Props {
  doc: CollectionEntry<'docs'>;
}

const { doc } = Astro.props;
const { title, seoTitle, description, updated } = doc.data;

const [latestVersion, { Content }] = await Promise.all([fetchLatestVersion(), render(doc)]);

const SITE_URL = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.nuza.org';
const PAGE_URL = `${SITE_URL}/docs/${doc.id}/`;

const structuredData = [
  {
    '@type': 'TechArticle',
    '@id': `${PAGE_URL}#doc`,
    mainEntityOfPage: PAGE_URL,
    url: PAGE_URL,
    headline: title,
    description,
    dateModified: updated.toISOString(),
    publisher: { '@id': `${SITE_URL}/#organization` },
    about: { '@id': `${SITE_URL}/#app` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'nuza', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: title, item: PAGE_URL },
    ],
  },
];
---

<Base
  title={`${seoTitle ?? title} | nuza`}
  description={description}
  structuredData={structuredData}
  version={latestVersion}
>
  <article>
    <header class="band">
      <div class="col px-5 py-12 sm:px-10 sm:py-16">
        <div class="rise-in">
          <nav aria-label="Breadcrumb" class="label">
            <a href="/" class="transition-colors hover:text-white">nuza</a>
            <span class="mx-1.5 text-zinc-600" aria-hidden="true">//</span>
            Docs
          </nav>
        </div>

        <h1 class="rise-in heading mt-6 max-w-3xl text-balance text-[1.5rem] leading-[1.25] sm:text-[2rem] sm:leading-[1.2]" style="--delay: 80ms">
          {title}
        </h1>

        <p class="rise-in label mt-6" style="--delay: 160ms">
          Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
        </p>
      </div>
    </header>

    <div class="band">
      <div class="col px-5 py-10 sm:px-10 sm:py-14">
        <div class="post mx-auto max-w-[44rem]">
          <Content />
        </div>

        <div class="mx-auto mt-12 flex max-w-[44rem] flex-wrap gap-3 border-t border-line pt-8">
          <a href="https://github.com/puang59/nuza/releases/latest" data-dl-quick class="btn btn-primary">
            Download nuza
          </a>
          <a href="https://github.com/puang59/nuza/issues" class="btn btn-ghost">Ask a question</a>
        </div>
      </div>
    </div>
  </article>
</Base>
