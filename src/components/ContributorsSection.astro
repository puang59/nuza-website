---
// The people who have built nuza, as listed by GitHub (bots left out, see
// lib/contributors.ts), followed by an invite to join them. The last card in
// the grid is an empty seat that leads to the contributing guide.
//
// Avatars come straight from GitHub's avatar CDN, sized down with `s=`. If
// one fails to load, the image removes itself and the initial behind it shows.

import type { Contributor } from '../lib/contributors';

interface Props {
  contributors: Contributor[];
}

const { contributors } = Astro.props;

const REPO_URL = 'https://github.com/puang59/nuza';
const CONTRIBUTING_URL = `${REPO_URL}/blob/main/CONTRIBUTING.md`;
const ISSUES_URL = `${REPO_URL}/issues`;

const avatar = (src: string) => {
  const url = new URL(src);
  url.searchParams.set('s', '96');
  return url.toString();
};
const commits = (n: number) => `${n} ${n === 1 ? 'commit' : 'commits'}`;
---

<section id="contributors" class="band" aria-labelledby="contributors-title">
  <div class="col">
    <div class="border-b border-line px-5 py-6 sm:px-10 sm:py-8" data-reveal>
      <p class="label">Contributors</p>
      <h2 id="contributors-title" class="heading mt-2 text-2xl sm:text-3xl">Creators of nuza</h2>
      <p class="mt-3 max-w-xl text-[13px] leading-[1.8] text-zinc-400">
        nuza is open source and built in the open. These are the people whose code is in it.
      </p>
    </div>

    <ul class="grid grid-cols-2 gap-3 px-5 py-6 sm:grid-cols-3 sm:gap-4 sm:px-10 sm:py-10 lg:grid-cols-4" data-reveal style="--delay: 100ms">
      {contributors.map((c) => (
        <li>
          <a
            href={c.url}
            target="_blank"
            rel="noopener noreferrer"
            class="box flex h-full items-center gap-3 p-4 transition-colors hover:border-[#575757]"
          >
            <span class="relative flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-raised text-[13px] font-medium uppercase text-zinc-300">
              {c.login[0]}
              <img
                src={avatar(c.avatar)}
                alt=""
                width="40"
                height="40"
                loading="lazy"
                decoding="async"
                onerror="this.remove()"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </span>
            <span class="min-w-0 leading-tight">
              <span class="block truncate text-[13px] font-medium text-white">@{c.login}</span>
              <span class="mt-1 block text-[12px] text-zinc-500">{commits(c.contributions)}</span>
            </span>
          </a>
        </li>
      ))}
      <li>
        <a
          href={CONTRIBUTING_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex h-full items-center gap-3 border border-dashed border-[#3d3d3d] p-4 transition-colors hover:border-accent"
        >
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-dashed border-[#575757] text-zinc-400 transition-colors group-hover:border-accent group-hover:text-accent" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </span>
          <span class="min-w-0 leading-tight">
            <span class="block text-[13px] font-medium text-white">You?</span>
            <span class="mt-1 block text-[12px] text-zinc-500">Your first commit</span>
          </span>
        </a>
      </li>
    </ul>

    <div class="flex flex-col gap-6 border-t border-line px-5 py-8 sm:px-10 sm:py-10 md:flex-row md:items-center md:justify-between" data-reveal>
      <div>
        <h3 class="text-[13px] font-bold uppercase tracking-[0.08em] text-white">
          <span class="mr-2 text-accent" aria-hidden="true">+</span>Help build nuza
        </h3>
        <p class="mt-3 max-w-xl text-pretty text-[13px] leading-[1.8] text-zinc-400">
          Fix a bug, add a feature, improve the docs or just report what feels off. Every change
          is welcome, big or small, and your name joins the list above with your first merged
          commit.
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        <a href={CONTRIBUTING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Start contributing
        </a>
        <a href={ISSUES_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          Browse open issues
        </a>
      </div>
    </div>
  </div>
</section>
