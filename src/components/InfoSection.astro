---
// The top of the page, in three stacked bands inside the column: the pitch
// and the download buttons set over the painting, the intro video, and the
// team's note about why nuza exists.
//
// The painting is clipped by its own layer rather than by the band, so the
// platform menu can hang over the band's lower edge instead of being cut
// off by it.

import DownloadButton from './DownloadButton.astro';
import { formatStarCount } from '../lib/stars';

export interface Props {
  version: string;
  /** GitHub stars at build time, or null when the count could not be read. */
  stars: number | null;
}

const { version, stars } = Astro.props;

const notes = [
  {
    title: 'Why we built it',
    body: 'Honestly? We started building nuza just for fun, to see if we could completely replace our daily note-taking apps with something substantially lighter and faster. We wanted a tool that does exactly what you need it to do: nothing extra, no bloated plugins, and no sluggish startup times. It is brutally simple and just works right out of the box.',
  },
  {
    title: 'Under the hood',
    body: 'nuza is a native desktop application powered by Rust via Tauri. The frontend is extremely minimal, written in React and TypeScript, while the writing experience is driven by CodeMirror to provide flawless, native-feeling Vim keybindings.',
  },
  {
    title: 'Fully open source',
    body: "nuza is entirely open source and community-driven. If you want to help us make the ultimate minimalist editor, pull requests are always welcome. Whether it's fixing a bug, tweaking the UI, or just starring the repository, jump into the GitHub and come build with us!",
  },
];
---

<!-- Pitch -->
<section class="band relative z-10" aria-labelledby="hero-title">
  <div class="col isolate flex min-h-[38rem] flex-col items-center justify-center px-5 py-20 text-center sm:px-10 md:min-h-[44rem]">

    <div class="absolute inset-0 -z-10 overflow-hidden bg-panel">
      <picture>
        <source srcset="/bg.webp" type="image/webp" />
        <img
          src="/bg.png"
          alt="A painting of a philosopher in a laurel wreath resting on temple steps at dusk, looking out over a bay towards a distant city"
          width="1672"
          height="941"
          fetchpriority="high"
          decoding="async"
          class="art-settle h-full w-full object-cover object-[18%_50%] sm:object-center"
        />
      </picture>
      <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>
    </div>

    <a
      href="#changelog"
      class="rise-in group inline-flex items-center gap-2.5 border border-[#333] bg-ink p-1 pr-3 text-[12px] text-zinc-200 transition-colors hover:border-[#575757]"
    >
      <span class="flex items-center gap-1.5 bg-raised px-2 py-0.5 text-[11px] font-bold text-white">
        <span class="h-1.5 w-1.5 bg-accent"></span>
        {version ? `v${version}` : 'new'}
      </span>
      <span class="sm:hidden">free and open source</span>
      <span class="hidden sm:inline">simple &middot; lightweight &middot; open source</span>
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
        <path d="M9 5l7 7-7 7" />
      </svg>
    </a>

    <h1
      id="hero-title"
      class="rise-in heading mt-7 max-w-4xl text-balance text-[1.65rem] leading-[1.2] sm:text-4xl sm:leading-[1.15] lg:text-[2.6rem]"
      style="--delay: 80ms"
    >
      A simple, lightweight home for your markdown notes
    </h1>

    <div
      class="rise-in mt-6 max-w-3xl text-pretty text-[13px] leading-[1.8] text-zinc-300 sm:text-[14.5px]"
      style="--delay: 160ms"
    >
      <p>
        <strong class="font-medium text-white">nuza</strong> is a lightning-fast, privacy-first,
        open-source alternative to Obsidian. A lightweight markdown editor for macOS, Windows and
        Linux with native Vim keybindings and plain local files, without the bloat.
      </p>
    </div>

    <!-- Raised above what follows: each `rise-in` block is its own stacking
         layer, so without this the badge below paints over the open menu. -->
    <div class="rise-in relative z-10 mt-8 w-full" style="--delay: 240ms">
      <DownloadButton>
        <a
          href="https://github.com/puang59/nuza"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost"
          aria-label={stars !== null ? `View on GitHub, ${stars} stars` : 'View on GitHub'}
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
          </svg>
          View on GitHub
          {stars !== null && (
            <span class="-mr-1 ml-1 flex items-center gap-1.5 self-stretch border-l border-[#575757] pl-3 text-zinc-300">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="text-accent" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
              {formatStarCount(stars)}
            </span>
          )}
        </a>
      </DownloadButton>
    </div>

    <!-- Where nuza has been launched, side by side; they wrap to two rows
         on a screen too narrow for both. -->
    <div class="rise-in mt-6 inline-flex flex-wrap items-center gap-3" style="--delay: 320ms">
      <a
        href="https://www.producthunt.com/products/nuza?embed=true&utm_source=badge-featured&utm_medium=badge&utm_campaign=badge-nuza"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          alt="nuza - A simple, lightweight home for your markdown notes | Product Hunt"
          width="250"
          height="54"
          loading="lazy"
          src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1269961&theme=light&t=1791170302536"
        />
      </a>
      <a href="https://www.dotstore.io/launches/2026-w42/nuza" target="_blank" rel="noopener">
        <img
          alt="nuza on dotstore"
          width="250"
          height="56"
          loading="lazy"
          src="https://www.dotstore.io/launches/2026-w42/nuza/badge/light.svg"
        />
      </a>
    </div>
  </div>
</section>

<!-- Intro video. It starts when it is about to scroll into view rather than
     on page load (see src/scripts/demo-video.ts), so the first screen is not
     competing with an 18 MB download. The video node itself is moved into
     #demo-video-overlay on expand and back here on collapse, so there's only
     ever one <video> (no duplicate load/playback to keep in sync). -->
<section id="demo" class="band" aria-label="nuza intro video">
  <div class="col px-4 py-10 sm:px-10 sm:py-16">
    <div class="box mx-auto max-w-5xl" data-reveal>
      <div class="flex items-center justify-between gap-4 border-b border-line px-4 py-2.5 text-[11px] text-zinc-500">
        <span class="flex items-center gap-2 text-zinc-300">
          <span class="h-1.5 w-1.5 bg-accent"></span>
          nuza-intro.mp4
        </span>
        <span class="hidden uppercase tracking-[0.2em] sm:block">click to enlarge</span>
      </div>

      <div id="demo-video-slot" class="aspect-video w-full">
        <div id="demo-video-stage" class="relative w-full">
          <video
            id="demo-video"
            data-src="https://nuza-cdn.puang.in/nuza-intro-v3.mp4"
            poster="/demo-poster.webp"
            class="aspect-video w-full bg-panel object-cover cursor-zoom-in"
            preload="none"
            muted
            loop
            playsinline
            disablePictureInPicture
            disableRemotePlayback
            controlsList="nodownload noplaybackrate nofullscreen"
            tabindex="-1"
            aria-label="nuza intro video: a note rendering as it is written, the vault's file tree beside it, open tabs across the top and Vim mode in the status bar"
          ></video>

          <button
            id="demo-video-mute"
            type="button"
            aria-label="Unmute video"
            aria-pressed="false"
            class="absolute bottom-3 right-3 z-10 flex h-8 w-8 items-center justify-center border border-[#575757] bg-ink/80 text-zinc-200 transition-colors hover:bg-raised hover:text-white cursor-pointer"
          >
            <svg data-icon="muted" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <line x1="23" y1="9" x2="17" y2="15"></line>
              <line x1="17" y1="9" x2="23" y2="15"></line>
            </svg>
            <svg data-icon="unmuted" class="hidden" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <noscript>
      <p class="mt-4 text-center text-[12px] text-zinc-400">
        <a href="https://nuza-cdn.puang.in/nuza-intro-v3.mp4" class="underline">Watch the nuza intro video</a>
      </p>
    </noscript>
  </div>
</section>

<!-- A note from the team -->
<section id="about" class="band" aria-labelledby="about-title">
  <div class="col">
    <div class="border-b border-line px-5 py-5 sm:px-10">
      <h2 id="about-title" class="label">A note from the nuza team</h2>
    </div>
    <div class="grid md:grid-cols-3">
      {notes.map((note, i) => (
        <div class="border-b border-line px-5 py-8 last:border-b-0 sm:px-10 md:border-b-0 md:border-r md:px-8 md:py-10 md:last:border-r-0 lg:px-10">
          <div data-reveal style={`--delay: ${i * 90}ms`}>
            <h3 class="flex items-center gap-3 text-[13px] font-bold uppercase tracking-[0.08em] text-white">
              <span class="text-[11px] font-normal text-accent" aria-hidden="true">0{i + 1}</span>
              {note.title}
            </h3>
            <p class="mt-4 text-[13px] leading-[1.85] text-zinc-400">{note.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Expanded demo video overlay: the stage (video + mute button) is
     reparented in here on click. -->
<div
  id="demo-video-overlay"
  class="hidden fade-in fixed inset-0 z-[200] items-center justify-center bg-black/90 p-4 backdrop-blur-sm cursor-zoom-out sm:p-10"
  role="dialog"
  aria-modal="true"
  aria-label="nuza demo video, expanded"
></div>
