---
// One marquee row for the previews gallery, rendered twice (back to back)
// per instance so the loop has no visible seam. The column's own rails are
// what the row runs out under, so it needs no fade at its edges.
//
// The screenshots are the app's own window, shadow and all, on a transparent
// ground, so they are shown as they are rather than boxed in a second frame.

export interface Props {
  items: { index: number; src: string; alt: string }[];
  direction: 'left' | 'right';
  duration: number;
  heightClass?: string;
}

const { items, direction, duration, heightClass = 'h-64 lg:h-72' } = Astro.props;
---

<div class={`pv-row no-scrollbar relative w-full overflow-hidden ${heightClass}`}>
  <div
    class={`pv-row-track flex h-full w-max items-center ${direction === 'left' ? 'pv-row-left' : 'pv-row-right'}`}
    style={`--pv-duration: ${duration}s`}
  >
    {[false, true].map((duplicate) =>
      items.map((p) => (
        <button
          type="button"
          class="pv-item group relative h-full shrink-0 cursor-zoom-in"
          data-index={p.index}
          aria-label={`Open full size: ${p.alt}`}
          aria-hidden={duplicate ? 'true' : undefined}
          tabindex={duplicate ? -1 : 0}
        >
          <img
            src={p.src}
            alt={duplicate ? '' : p.alt}
            width="1050"
            height="735"
            loading="lazy"
            decoding="async"
            class="h-full w-auto object-contain transition-transform duration-500 ease-out-soft group-hover:scale-[1.025]"
          />
        </button>
      ))
    )}
  </div>
</div>
