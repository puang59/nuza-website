---
// What people have said about nuza: replies to the team's posts on X, shown
// as two marquee rows running in opposite directions, reusing the gallery's
// scrolling track (see global.css). The text is kept here rather than loaded from X's embed
// script, so the row costs no third-party JavaScript and cannot shift as
// embeds load in.
//
// Each card links to the original post. Each row is rendered twice back to
// back so the loop has no seam; the second copy is hidden from assistive
// tech and the tab order.
//
// Avatars are copies saved under public/testimonials/<handle>.jpg, because
// X's image URLs stop working whenever someone changes their picture. If a
// file is missing anyway, the image removes itself and the initials behind
// it show instead.

const TESTIMONIALS = [
  {
    name: 'Vardhman',
    handle: 'flcrom',
    text: 'this one was so needed, nice.',
    url: 'https://x.com/flcrom/status/2108228588566893037',
  },
  {
    name: 'Ruben Veidt',
    handle: 'RubenVeidt',
    text: 'so perfect, i will main drive nuza from now on',
    url: 'https://x.com/RubenVeidt/status/2108191500043690428',
  },
  {
    name: 'saksham',
    handle: 'skshmgpt',
    text: 'ts so good, i have ditched obsidian',
    url: 'https://x.com/skshmgpt/status/2103413120744169620',
  },
  {
    name: 'Deepanshu Mishra',
    handle: 'dipxsyy',
    text: 'bro out there building the best obsidian alternative 🗣️',
    url: 'https://x.com/dipxsyy/status/2105631200232776007',
  },
  {
    name: 'chidam',
    handle: 'Chidam333',
    text: 'Tried it out a few days ago and really liked it. Good job',
    url: 'https://x.com/Chidam333/status/2105652148730286441',
  },
  {
    name: 'nexxel',
    handle: 'nexxeln',
    text: 'wow i like printing ntoes',
    url: 'https://x.com/nexxeln/status/2105667475522326830',
  },
  {
    name: 'anirudh',
    handle: 'anirudhprmar',
    text: 'sick!',
    url: 'https://x.com/anirudhprmar/status/2105894145865011667',
  },
  {
    name: 'Nasal Dragon',
    handle: 'nasaldragon',
    text: 'Damn!',
    url: 'https://x.com/nasaldragon/status/2103392829548708291',
  },
  {
    name: 'MBVRK',
    handle: 'meMBVRK',
    text: 'I swear I was today looking for a good alternative, I will try this great app tomorrow',
    url: 'https://x.com/meMBVRK/status/2118446735244538350',
  },
  {
    name: 'The Penny Pincher',
    handle: 'onion_debugger',
    text: 'Absolutely love this note taking app, thanks for the update allowing for changing mono font',
    url: 'https://x.com/onion_debugger/status/2118495179384438913',
  },
];

const initials = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((word) => word[0])
    .join('')
    .toUpperCase();

// Cards alternate between the rows, so neighbours in the list (like the two
// one-word replies) never sit side by side.
const ROWS = [
  { items: TESTIMONIALS.filter((_, i) => i % 2 === 0), direction: 'pv-row-left' },
  { items: TESTIMONIALS.filter((_, i) => i % 2 === 1), direction: 'pv-row-right' },
];
---

<section id="testimonials" class="band" aria-labelledby="testimonials-title">
  <div class="col overflow-hidden">
    <div class="border-b border-line px-5 py-6 sm:px-10 sm:py-8" data-reveal>
      <p class="label">Testimonials</p>
      <h2 id="testimonials-title" class="heading mt-2 text-2xl sm:text-3xl">
        Don't just take our word for it
      </h2>
      <p class="mt-3 max-w-xl text-[13px] leading-[1.8] text-zinc-400">
        A few things people have said about nuza on X.
      </p>
    </div>

    <div class="flex flex-col gap-4 py-6 sm:py-10" data-reveal style="--delay: 100ms">
      {ROWS.map((row) => (
        <div class="pv-row no-scrollbar relative w-full overflow-hidden">
          <div class={`pv-row-track ${row.direction} flex w-max items-stretch`} style="--pv-duration: 32s">
            {[false, true].map((duplicate) =>
              row.items.map((t) => (
                <a
                  href={t.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="box mr-4 flex w-72 shrink-0 flex-col justify-between gap-6 p-5 transition-colors hover:border-[#575757] sm:w-80"
                  aria-hidden={duplicate ? 'true' : undefined}
                  tabindex={duplicate ? -1 : undefined}
                >
                  <p class="text-pretty text-[14px] leading-[1.7] text-zinc-200">{t.text}</p>
                  <div class="flex items-center gap-3">
                    <span class="relative flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-full bg-raised text-[12px] font-medium text-zinc-300">
                      {initials(t.name)}
                      <img
                        src={`/testimonials/${t.handle.toLowerCase()}.jpg`}
                        alt=""
                        width="36"
                        height="36"
                        loading="lazy"
                        decoding="async"
                        onerror="this.remove()"
                        class="absolute inset-0 h-full w-full object-cover"
                      />
                    </span>
                    <div class="min-w-0 leading-tight">
                      <p class="truncate text-[13px] font-medium text-white">{t.name}</p>
                      <p class="truncate text-[12px] text-zinc-500">@{t.handle}</p>
                    </div>
                  </div>
                </a>
              ))
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
