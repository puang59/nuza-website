---
// The last few releases and the commits in each, read from GitHub at build
// time. One release is shown at a time; the arrows step through the rest.

import type { ChangelogData } from '../lib/changelog';
import { CATEGORY_COLORS, categorizeCommit, formatDate } from '../lib/changelog';

interface Props {
  changelogs: ChangelogData[];
}

const { changelogs } = Astro.props;

const displayTag = (tag: string) => tag.replace(/^(app-)?v?/, 'v');
---

<section id="changelog" class="band" aria-labelledby="changelog-title">
  <div class="col">

    <div class="flex flex-col gap-5 border-b border-line px-5 py-6 sm:flex-row sm:items-end sm:justify-between sm:px-10 sm:py-8" data-reveal>
      <div>
        <p class="label">Releases</p>
        <h2 id="changelog-title" class="heading mt-2 text-2xl sm:text-3xl">Changelog</h2>
        <p class="mt-3 max-w-xl text-[13px] leading-[1.8] text-zinc-400">
          Every release of nuza and the commits that went into it, straight from the repository.
        </p>
      </div>

      <div class="flex shrink-0 items-center gap-3">
        {changelogs.length > 0 && (
          <div class="flex h-10 items-stretch border border-[#575757] bg-ink">
            <button
              id="cl-prev"
              type="button"
              class="flex w-9 items-center justify-center text-zinc-400 transition-colors hover:bg-raised hover:text-white disabled:opacity-30 disabled:hover:bg-transparent cursor-pointer disabled:cursor-default"
              aria-label="Older release"
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <span
              id="cl-version-display"
              class="flex min-w-[4.5rem] items-center justify-center border-x border-[#575757] px-2 text-[12px] text-zinc-100 whitespace-nowrap"
              aria-live="polite"
            >
              {displayTag(changelogs[0].release.tag)}
            </span>
            <button
              id="cl-next"
              type="button"
              class="flex w-9 items-center justify-center text-zinc-400 transition-colors hover:bg-raised hover:text-white disabled:opacity-30 disabled:hover:bg-transparent cursor-pointer disabled:cursor-default"
              disabled
              aria-label="Newer release"
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        )}

        <a
          href="https://github.com/puang59/nuza/releases"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost"
        >
          View all &#x2197;
        </a>
      </div>
    </div>

    <div class="px-4 py-6 sm:px-10 sm:py-10" data-reveal style="--delay: 100ms">
      <div class="box">
        {changelogs.length === 0 ? (
          <div class="p-6 sm:p-8">
            <p class="label">No commits found</p>
            <p class="mt-3 max-w-sm text-[13px] leading-[1.8] text-zinc-400">
              Check back soon, or watch the{' '}
              <a
                href="https://github.com/puang59/nuza"
                target="_blank"
                rel="noopener noreferrer"
                class="text-zinc-200 underline decoration-accent/50 underline-offset-4 transition-colors hover:text-white"
              >repository</a>{' '}
              for updates.
            </p>
          </div>
        ) : (
          changelogs.map((data, index) => (
            <div class={`cl-panel fade-in ${index !== 0 ? 'hidden' : ''}`} data-index={index} data-tag={data.release.tag}>

              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-line px-4 py-4 sm:px-6">
                <span class="flex items-center gap-1.5 bg-raised px-2 py-1 text-[11px] font-bold text-white">
                  <span class="h-1.5 w-1.5 bg-accent"></span>
                  {displayTag(data.release.tag)}
                </span>
                <h3 class="text-[14px] font-bold text-white">
                  <a
                    href={data.release.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="transition-colors hover:text-zinc-300"
                  >
                    {data.release.title}
                  </a>
                </h3>
                <time datetime={data.release.date} class="ml-auto shrink-0 text-[11px] text-zinc-500">
                  {formatDate(data.release.date)}
                </time>
              </div>

              {data.commits.length === 0 ? (
                <p class="px-4 py-8 text-[12px] italic text-zinc-500 sm:px-6">No commits found for this release.</p>
              ) : (
                <ul class="thin-scrollbar max-h-[30rem] overflow-y-auto overscroll-contain">
                  {data.commits.map((commit) => {
                    const category = categorizeCommit(commit.title);
                    const color = CATEGORY_COLORS[category];
                    return (
                      <li class="border-b border-line last:border-0">
                        <a
                          href={commit.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="group flex items-baseline gap-3 px-4 py-3 transition-colors hover:bg-raised sm:gap-4 sm:px-6"
                        >
                          <span class={`w-14 shrink-0 text-[10px] font-bold uppercase tracking-widest sm:w-16 ${color}`}>
                            {category}
                          </span>
                          <span class="min-w-0 flex-1 truncate text-[12.5px] text-zinc-400 transition-colors group-hover:text-zinc-100">
                            {commit.title}
                          </span>
                          <time datetime={commit.date} class="hidden shrink-0 text-[11px] text-zinc-600 sm:block">
                            {formatDate(commit.date)}
                          </time>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              )}
            </div>
          ))
        )}
      </div>
    </div>
  </div>
</section>

<script>
  function initChangelogSlider() {
    const prevBtn = document.getElementById('cl-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('cl-next') as HTMLButtonElement | null;
    const versionDisplay = document.getElementById('cl-version-display');
    const panels = document.querySelectorAll<HTMLElement>('.cl-panel');

    if (!prevBtn || !nextBtn || !versionDisplay || panels.length === 0) return;

    let currentIndex = 0;
    const maxIndex = panels.length - 1;

    function updateView() {
      if (prevBtn) prevBtn.disabled = currentIndex === maxIndex;
      if (nextBtn) nextBtn.disabled = currentIndex === 0;

      panels.forEach((panel) => {
        const index = parseInt(panel.dataset.index || '0', 10);
        if (index === currentIndex) {
          panel.classList.remove('hidden');
          if (versionDisplay) {
            const tag = panel.dataset.tag || '';
            versionDisplay.textContent = tag.replace(/^(app-)?v?/, 'v');
          }
        } else {
          panel.classList.add('hidden');
        }
      });
    }

    prevBtn.addEventListener('click', () => {
      if (currentIndex < maxIndex) {
        currentIndex++;
        updateView();
      }
    });

    nextBtn.addEventListener('click', () => {
      if (currentIndex > 0) {
        currentIndex--;
        updateView();
      }
    });

    updateView();
  }

  document.addEventListener('DOMContentLoaded', initChangelogSlider);
</script>
