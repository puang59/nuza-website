---
import type { ChangelogData } from '../lib/changelog';
import { CATEGORY_COLORS, categorizeCommit, formatDate } from '../lib/changelog';

interface Props {
  changelogs: ChangelogData[];
}

const { changelogs } = Astro.props;
---

<section id="changelog-section" class="snap-start shrink-0 min-h-screen lg:h-screen flex flex-col px-5 py-8 sm:px-8 sm:py-10 lg:px-14 lg:py-12 overflow-hidden">

  <!-- Header -->
  <div class="flex items-center justify-between mb-6 shrink-0">
    <div>
      <p class="text-[9px] sm:text-[10px] uppercase tracking-[0.25em] text-zinc-600 mb-1">releases</p>
      <h2 class="text-base sm:text-lg font-bold text-white font-sans">changelog</h2>
    </div>
    
    <div class="flex flex-col-reverse sm:flex-row items-end sm:items-center gap-3 sm:gap-5">
      <!-- Slider Control -->
      {changelogs.length > 0 && (
        <div class="flex items-center gap-2 bg-[#0d0d0d] border border-zinc-800 px-2 py-1 text-sm">
          <button id="cl-prev" class="text-zinc-500 hover:text-white disabled:opacity-30 transition-colors cursor-pointer disabled:cursor-default" aria-label="Older Release">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <span id="cl-version-display" class="text-[11px] font-mono text-neutral-300 text-center shrink-0 min-w-[50px] px-1 whitespace-nowrap">
            {changelogs[0].release.tag.replace(/^(app-)?v?/, 'v')}
          </span>
          <button id="cl-next" class="text-zinc-500 hover:text-white disabled:opacity-30 transition-colors cursor-pointer disabled:cursor-default" disabled aria-label="Newer Release">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      )}
      
      <a
        href="https://github.com/puang59/nuza/releases"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[9px] sm:text-[10px] font-mono text-zinc-600 hover:text-zinc-400 transition-colors tracking-widest uppercase self-start sm:self-center mt-1 sm:mt-0"
      >
        view all &#x2197;
      </a>
    </div>
  </div>

  <!-- Content container -->
  <div class="flex-1 overflow-y-auto no-scrollbar pr-2">
    {changelogs.length === 0 ? (
      <div class="flex flex-col items-start gap-3 mt-4">
        <p class="text-[10px] uppercase tracking-[0.2em] text-zinc-700">no commits found</p>
        <p class="text-[12.5px] leading-[1.8] text-neutral-500 max-w-sm">
          check back soon or watch the
          <a
            href="https://github.com/puang59/nuza"
            target="_blank"
            rel="noopener noreferrer"
            class="text-neutral-400 hover:text-neutral-200 transition-colors ml-1"
          >
            repository
          </a>
          for updates.
        </p>
      </div>
    ) : (
      changelogs.map((data, index) => (
        <div class={`cl-panel flex flex-col pb-8 ${index !== 0 ? 'hidden' : ''}`} data-index={index} data-tag={data.release.tag}>
          
          <div class="shrink-0 mb-6">
            <div class="flex items-baseline gap-3 pb-3 border-b border-zinc-800/60">
              <a
                href={data.release.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-white font-bold text-sm hover:text-neutral-300 transition-colors font-sans"
              >
                {data.release.title}
              </a>
              <span class="text-[9px] text-zinc-700 ml-auto shrink-0">
                {formatDate(data.release.date)}
              </span>
            </div>
          </div>

          {data.commits.length === 0 ? (
            <p class="text-[11px] text-zinc-500 italic mt-2">No commits found for this release.</p>
          ) : (
            <ul class="space-y-0.5">
              {data.commits.map((commit) => {
                const category = categorizeCommit(commit.title);
                const color = CATEGORY_COLORS[category];
                return (
                  <li class="group flex items-start gap-3 py-2.5 border-b border-zinc-800/30 last:border-0 hover:bg-zinc-800/10 transition-colors -mx-2 px-2 rounded-sm">
                    <span class={`text-[9px] uppercase tracking-widest font-bold font-mono mt-0.5 w-14 shrink-0 ${color}`}>
                      {category}
                    </span>

                    <div class="flex-1 min-w-0">
                      <a
                        href={commit.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[12px] sm:text-[12.5px] text-neutral-400 hover:text-neutral-200 transition-colors block truncate"
                      >
                        {commit.title}
                      </a>
                    </div>

                    <span class="text-[9px] text-zinc-700 shrink-0 mt-0.5">
                      {formatDate(commit.date)}
                    </span>
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      ))
    )}
  </div>

</section>

<script>
  function initChangelogSlider() {
    const prevBtn = document.getElementById('cl-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('cl-next') as HTMLButtonElement | null;
    const versionDisplay = document.getElementById('cl-version-display');
    const panels = document.querySelectorAll<HTMLElement>('.cl-panel');

    if (!prevBtn || !nextBtn || !versionDisplay || panels.length === 0) return;

    let currentIndex = 0;
    const maxIndex = panels.length - 1;

    function updateView() {
      // Update buttons
      if (prevBtn) prevBtn.disabled = currentIndex === maxIndex;
      if (nextBtn) nextBtn.disabled = currentIndex === 0;

      // Update visibility
      panels.forEach((panel) => {
        const index = parseInt(panel.dataset.index || '0', 10);
        if (index === currentIndex) {
          panel.classList.remove('hidden');
          if (versionDisplay) {
            const tag = panel.dataset.tag || '';
            versionDisplay.textContent = tag.replace(/^(app-)?v?/, 'v');
          }
        } else {
          panel.classList.add('hidden');
        }
      });
    }

    prevBtn.addEventListener('click', () => {
      if (currentIndex < maxIndex) {
        currentIndex++;
        updateView();
      }
    });

    nextBtn.addEventListener('click', () => {
      if (currentIndex > 0) {
        currentIndex--;
        updateView();
      }
    });

    updateView();
  }

  document.addEventListener('DOMContentLoaded', initChangelogSlider);
</script>
