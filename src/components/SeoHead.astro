---
// Everything a page puts in <head> for search and sharing: title,
// description, canonical, icons, Open Graph, Twitter and structured data.
// Shared so every page says the same thing about the site the same way.

export interface Props {
  title: string;
  description: string;
  /** Schema.org nodes for this page, added to the graph beside the site's own. */
  structuredData?: Record<string, unknown>[];
  /** An image above the fold worth fetching before the stylesheet asks for it. */
  preloadImage?: string;
  /** Set on a blog post, which is an article with a writer and a date. */
  article?: { author: string; publishedTime: string };
}

const { title, description, structuredData = [], preloadImage, article } = Astro.props;

const SITE_URL = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.nuza.org';
const OG_IMAGE = `${SITE_URL}/banner.png`;
const IMAGE_ALT = 'nuza, a lightweight open-source markdown note taking app with Vim keybindings';

// The pathname as it is built, trailing slash and all, which is also how the
// sitemap lists it - a canonical that disagrees with the sitemap is a mixed
// signal about which address is the real one.
const PAGE_URL = `${SITE_URL}${Astro.url.pathname}`;

// The site's own entities, on every page. Pages add their own nodes beside
// these and point at them by @id rather than restating them.
const siteNodes = [
  {
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: 'nuza',
    alternateName: ['nuza notes', 'nuza markdown editor'],
    url: `${SITE_URL}/`,
    publisher: { '@id': `${SITE_URL}/#organization` },
  },
  // Named once, as the thing search engines attach the brand to. The nested
  // author and publisher objects elsewhere point here instead of repeating it.
  {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: 'nuza',
    url: `${SITE_URL}/`,
    logo: {
      '@type': 'ImageObject',
      '@id': `${SITE_URL}/#logo`,
      url: `${SITE_URL}/icon-512.png`,
      width: 512,
      height: 512,
      caption: 'nuza',
    },
    image: { '@id': `${SITE_URL}/#logo` },
    description:
      'nuza is a free, open-source markdown note taking app for macOS, Windows and Linux.',
    sameAs: ['https://github.com/puang59/nuza', 'https://github.com/puang59'],
  },
];

const graph = {
  '@context': 'https://schema.org',
  '@graph': [...siteNodes, ...structuredData],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Primary -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content="nuza, obsidian alternative, lightweight obsidian alternative, simple note taking app, markdown note taking, markdown editor, open source note taking, vim notes app, local-first notes, privacy-first notes, notes app for developers, markdown app macOS, markdown app windows, markdown app linux" />
<meta name="author" content={article?.author ?? 'nuza'} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow" />
<link rel="canonical" href={PAGE_URL} />

<!-- Icons: Google reads a size that is a multiple of 48px, and falls back to
     /favicon.ico when none is declared. -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="alternate" type="application/rss+xml" title="nuza blog" href="/blog/rss.xml" />

<!-- Open Graph (Facebook, LinkedIn, Discord, WhatsApp, Slack, Telegram, iMessage, etc.) -->
<meta property="og:type" content={article ? 'article' : 'website'} />
{article && <meta property="article:published_time" content={article.publishedTime} />}
{article && <meta property="article:author" content={article.author} />}
<meta property="og:url" content={PAGE_URL} />
<meta property="og:site_name" content="nuza" />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={OG_IMAGE} />
<meta property="og:image:secure_url" content={OG_IMAGE} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1920" />
<meta property="og:image:height" content="1080" />
<meta property="og:image:alt" content={IMAGE_ALT} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={PAGE_URL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={OG_IMAGE} />
<meta name="twitter:image:alt" content={IMAGE_ALT} />

<!-- Theming -->
<meta name="theme-color" content="#090909" />
<meta name="color-scheme" content="dark" />

<!-- Perf: the screenshots live on the CDN -->
<link rel="preconnect" href="https://nuza-cdn.puang.in" />
{preloadImage && <link rel="preload" as="image" href={preloadImage} type="image/webp" fetchpriority="high" />}

<!-- Marks the document as scripted before first paint, so the scroll
     reveals in global.css only hide what a script will later show. -->
<script is:inline>document.documentElement.classList.add('js');</script>

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
